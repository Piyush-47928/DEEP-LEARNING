        "        return self.reducer.transform(\n",
        "            self.scaler.transform(embs)\n",
        "        ).astype(np.float32)\n",
        "\n",
        "    def fit_transform(self,\n",
        "                       embs: np.ndarray,\n",
        "                       labels: np.ndarray) -> np.ndarray:\n",
        "        return self.fit(embs, labels)\n",
        "\n",
        "    @property\n",
